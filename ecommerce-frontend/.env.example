# VCare E-commerce Frontend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================
# Backend API Configuration
# ===========================
# Development: http://localhost:3000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3000/api

# ===========================
# Supabase Configuration
# ===========================
# Get these from your Supabase project:
# 1. Go to supabase.com
# 2. Open your project
# 3. Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ===========================
# Notes
# ===========================
# - All environment variables must start with VITE_ to be accessible in the app
# - NEVER commit this file with real credentials to version control
# - The ANON key is safe to expose in frontend (it's public by design)
# - Ensure VITE_API_URL matches your backend deployment
# - For production, use HTTPS URLs
# - The same Supabase project should be used across all applications
