# VCare POS System Frontend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================
# Backend API Configuration
# ===========================
# Development: http://localhost:3000/api
# Production: https://api.yourdomain.com/api
# VITE_API_URL=http://localhost:3000/api
VITE_API_URL=https://vcaresl.com/api
# ===========================
# Supabase Configuration
# ===========================
# Get these from your Supabase project:
# 1. Go to supabase.com
# 2. Open your project
# 3. Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ===========================
# Barcode Scanner Configuration
# ===========================
# Enable/disable barcode scanner functionality
VITE_BARCODE_SCANNER_ENABLED=true

# Keys that indicate end of barcode scan (comma-separated)
VITE_BARCODE_END_KEYS=Enter,Tab

# Minimum barcode length to process
VITE_BARCODE_MIN_LENGTH=4

# Timeout between keystrokes to detect barcode (milliseconds)
VITE_BARCODE_TIMEOUT_MS=80

# Allow barcode scanning even when input fields are focused
VITE_BARCODE_ALLOW_IN_INPUTS=true

# Barcode prefix (leave empty if not used)
VITE_BARCODE_PREFIX=

# Barcode suffix (leave empty if not used)
VITE_BARCODE_SUFFIX=

# Show barcode simulator in development
VITE_BARCODE_SIMULATOR_VISIBLE=true

# ===========================
# Notes
# ===========================
# - All environment variables must start with VITE_ to be accessible in the app
# - NEVER commit this file with real credentials to version control
# - For production, set VITE_BARCODE_SIMULATOR_VISIBLE=false
# - The ANON key is safe to expose in frontend (it's public by design)
# - Ensure VITE_API_URL matches your backend deployment
